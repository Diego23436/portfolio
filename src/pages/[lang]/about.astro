---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import ResumeCards from "../../components/ResumeCards.astro";
import TechStack from "../../components/TechStack.astro";
import ProfessionalSkills from "../../components/ProfessionalSkills.astro";
import { content, locales, profile, type Locale } from "../../data/content";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = content[lang];
---

<BaseLayout lang={lang} title={t.nav.about}>
  <section class="mx-auto grid max-w-6xl gap-8 px-4 py-16 sm:px-6 md:grid-cols-[0.95fr_1.05fr] md:items-center lg:px-8">
    <div>
      <SectionHeading title={t.about.title} />
      <div class="mt-6 grid gap-4 text-base leading-7 text-portfolio-muted dark:text-slate-300">
        {t.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <ul class="mt-6 grid gap-2 text-sm font-semibold text-portfolio-ink dark:text-slate-100">
        <li>{t.about.location}</li>
        <li>{t.about.languages}</li>
      </ul>
    </div>

    <figure class="mx-auto w-full max-w-md overflow-hidden rounded-xl border border-portfolio-line bg-white p-2 shadow-sm dark:border-portfolio-night-line dark:bg-portfolio-night-panel md:mx-0 md:justify-self-end">
      <img
        src={profile.photos.fullBody.src}
        alt={profile.photos.fullBody.alt[lang]}
        class="aspect-[4/5] size-full rounded-md object-cover object-top"
        loading="lazy"
        decoding="async"
      />
    </figure>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6 lg:px-8">
    <h2 class="text-2xl font-black">{t.focus.title}</h2>
    <div class="mt-5 grid gap-4 md:grid-cols-3">
      {
        t.focus.items.map((item) => (
          <article class="reveal rounded-xl border border-portfolio-line bg-white p-5 dark:border-portfolio-night-line dark:bg-portfolio-night-panel">
            <h3 class="font-black">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-portfolio-muted dark:text-slate-300">{item.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="mx-auto grid max-w-6xl gap-8 px-4 pb-16 sm:px-6 lg:px-8">
    <div class="grid gap-10 md:grid-cols-2">
      <div>
        <h2 class="text-2xl font-black">{t.experience.title}</h2>
        <div class="mt-6 grid gap-4">
          {
            t.experience.items.map((item) => (
              <article class="reveal rounded-xl border border-portfolio-line bg-white p-6 dark:border-portfolio-night-line dark:bg-portfolio-night-panel">
                {item.period && <p class="text-sm font-bold text-portfolio-accent">{item.period}</p>}
                <h3 class="mt-2 text-xl font-black">{item.title}</h3>
                <p class="mt-1 text-sm font-bold text-portfolio-muted dark:text-slate-400">{item.place}</p>
                {item.body && <p class="mt-3 text-sm leading-6 text-portfolio-muted dark:text-slate-300">{item.body}</p>}
              </article>
            ))
          }
        </div>
      </div>
      <div>
        <h2 class="text-2xl font-black">{t.education.title}</h2>
        <div class="mt-6 grid gap-4">
          {
            t.education.items.map((item) => (
              <article class="reveal rounded-xl border border-portfolio-line bg-white p-6 dark:border-portfolio-night-line dark:bg-portfolio-night-panel">
                {item.period && <p class="text-sm font-bold text-portfolio-accent">{item.period}</p>}
                <h3 class="mt-2 text-xl font-black">{item.title}</h3>
                <p class="mt-1 text-sm font-bold text-portfolio-muted dark:text-slate-400">{item.place}</p>
                {item.body && <p class="mt-3 text-sm leading-6 text-portfolio-muted dark:text-slate-300">{item.body}</p>}
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6 lg:px-8">
    <SectionHeading title={t.skills.title} intro={t.skills.intro} />
    <div class="mt-8"><TechStack lang={lang} /></div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6 lg:px-8">
    <SectionHeading title={t.proSkills.title} intro={t.proSkills.intro} />
    <div class="mt-8"><ProfessionalSkills lang={lang} /></div>
  </section>

  <section class="bg-white/70 py-16 dark:bg-portfolio-night-panel/60">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <SectionHeading title={t.resumePage.title} intro={t.resumePage.intro} />
      <div class="mt-8">
        <ResumeCards lang={lang} />
      </div>
    </div>
  </section>
</BaseLayout>
