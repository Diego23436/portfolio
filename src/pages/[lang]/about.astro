---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SkillsConstellation from "../../components/skills/SkillsConstellation.astro";
import ProfessionalSkills from "../../components/ProfessionalSkills.astro";
import { content, locales, profile, type Locale } from "../../data/content";
import "../../styles/pages.css";
import "../../styles/projects.css";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = content[lang];
const a = t.about;
const photo = profile.photos.fullBody;
---

<BaseLayout lang={lang} title={t.nav.about} description={a.paragraphs[0]}>
  <section class="wrap about-hero">
    <div>
      <h1 class="about-intro">{a.intro}</h1>
      <div class="about-text">
        {a.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <p class="about-meta mono">{a.meta}</p>
    </div>

    <figure class="about-photo" data-about-photo>
      <div class="about-frame">
        <img
          src={photo.src}
          alt={photo.alt[lang]}
          width={photo.width}
          height={photo.height}
          loading="eager"
          decoding="async"
          data-about-img
        />
      </div>
      <figcaption class="mono">{a.photoCaption}</figcaption>
    </figure>
  </section>

  <section class="wrap now">
    <div>
      <h2 class="sec-title">{a.now.title}</h2>
      <p class="mono" style="margin-top: 16px; color: rgb(var(--soft));">{a.now.updated}</p>
    </div>
    <ul class="now-list">
      {a.now.items.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="wrap" style="padding-top: clamp(72px, 10vw, 140px);">
    <div class="sec-head reveal"><h2 class="sec-title">{t.skills.title}</h2></div>
    <div style="margin-top: clamp(28px, 4vw, 48px);"><SkillsConstellation lang={lang} /></div>
  </section>

  <section class="wrap" style="padding-top: clamp(72px, 10vw, 140px);">
    <div class="sec-head reveal"><h2 class="sec-title">{t.proSkills.title}</h2></div>
    <div style="margin-top: clamp(28px, 4vw, 48px);"><ProfessionalSkills lang={lang} /></div>
  </section>

  <section class="wrap" style="padding-top: clamp(72px, 10vw, 140px);">
    <div class="sec-head reveal"><h2 class="sec-title">{a.pathTitle}</h2></div>
    <ol class="path" style="margin-top: clamp(28px, 4vw, 48px);">
      <li class="path-group mono">{t.experience.title}</li>
      {
        t.experience.items.map((item) => (
          <li class="path-row">
            <span class="path-when mono">{item.when}</span>
            <div>
              <h3 class="path-title">{item.title}</h3>
              <p class="path-place">{item.place}</p>
              {item.line && <p class="path-line">{item.line}</p>}
            </div>
          </li>
        ))
      }
      <li class="path-group mono" style="padding-top: 36px;">{t.education.title}</li>
      {
        t.education.items.map((item) => (
          <li class="path-row">
            <span class="path-when mono">{item.when}</span>
            <div>
              <h3 class="path-title">{item.title}</h3>
              <p class="path-place">{item.place}</p>
              {item.line && <p class="path-line">{item.line}</p>}
            </div>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>

<script>
  import "../../scripts/about";
</script>
