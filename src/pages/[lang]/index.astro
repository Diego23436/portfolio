---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import CvDownload from "../../components/CvDownload.astro";
import TechStack from "../../components/TechStack.astro";
import ProfessionalSkills from "../../components/ProfessionalSkills.astro";
import { content, locales, profile, projects, type Locale } from "../../data/content";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = content[lang];
const featuredProjects = projects.filter((project) => project.tier === "main");
---

<BaseLayout lang={lang}>
  <section class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 md:grid-cols-[1.15fr_0.85fr] md:items-center lg:px-8 lg:py-24">
    <div>
      <p class="text-sm font-black uppercase tracking-[0.18em] text-portfolio-accent">{t.hero.eyebrow}</p>
      <h1 class="mt-5 max-w-4xl text-balance text-4xl font-black leading-[1.04] text-portfolio-ink dark:text-white sm:text-5xl lg:text-6xl">
        {t.hero.title}
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-portfolio-muted dark:text-slate-300">{t.hero.intro}</p>
      <p class="mt-4 text-sm font-bold text-portfolio-ink dark:text-slate-100">{t.hero.availability}</p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href={`/${lang}/projects/`} class="rounded-md bg-portfolio-ink px-5 py-3 text-sm font-bold text-white transition hover:bg-portfolio-accent dark:bg-slate-100 dark:text-portfolio-night dark:hover:bg-portfolio-accent dark:hover:text-white">
          {t.actions.viewProjects}
        </a>
        <a href={`/${lang}/contact/`} class="rounded-md border border-portfolio-line bg-white px-5 py-3 text-sm font-bold text-portfolio-ink transition hover:border-portfolio-accent hover:text-portfolio-accent dark:border-portfolio-night-line dark:bg-portfolio-night-panel dark:text-slate-100">
          {t.actions.contactMe}
        </a>
        <CvDownload lang={lang} />
      </div>
    </div>

    <figure class="relative overflow-hidden rounded-lg border border-portfolio-line bg-white p-3 shadow-xl dark:border-portfolio-night-line dark:bg-portfolio-night-panel">
      <div class="profile-photo-flip relative aspect-[4/5] overflow-hidden rounded-md bg-portfolio-ink">
        <div class="profile-photo-flip-card absolute inset-0">
          <img
            src={profile.photos.portrait.src}
            alt={profile.photos.portrait.alt[lang]}
            class="profile-photo-face profile-photo-face-front size-full object-cover object-[58%_center]"
            decoding="async"
          />
          <img
            src={profile.photos.headshot.src}
            alt={profile.photos.headshot.alt[lang]}
            class="profile-photo-face profile-photo-face-back size-full object-cover object-center"
            decoding="async"
          />
        </div>
        <div class="absolute inset-0 bg-gradient-to-t from-portfolio-ink/85 via-portfolio-ink/10 to-transparent"></div>
        <figcaption class="absolute inset-x-0 bottom-0 p-5 text-white">
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-teal-200">{t.hero.cardLabel}</p>
          <p class="mt-2 text-xl font-black">{profile.displayName}</p>
          <p class="mt-1 text-sm text-slate-200">{profile.title}</p>
        </figcaption>
      </div>
    </figure>
  </section>

  <section class="border-y border-portfolio-line bg-white/70 dark:border-portfolio-night-line dark:bg-portfolio-night-panel/60">
    <div class="mx-auto grid max-w-6xl gap-4 px-4 py-6 sm:grid-cols-3 sm:px-6 lg:px-8">
      {
        t.stats.map((stat) => (
          <div class="rounded-lg border border-portfolio-line bg-white p-5 dark:border-portfolio-night-line dark:bg-portfolio-night-panel">
            <p class="text-2xl font-black text-portfolio-accent">{stat.value}</p>
            <p class="mt-1 text-sm text-portfolio-muted dark:text-slate-300">{stat.label}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="bg-white/70 py-16 dark:bg-portfolio-night-panel/60">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 sm:px-6 lg:px-8">
      <SectionHeading title={t.projects.title} intro={t.projects.intro} />
      <div class="grid gap-5 md:grid-cols-2">
        {featuredProjects.map((project) => <ProjectCard project={project} lang={lang} />)}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid gap-8 md:grid-cols-[0.95fr_1.05fr] md:items-end">
      <SectionHeading title={t.aboutPreview.title} intro={t.aboutPreview.body} />
      <div>
        <a href={`/${lang}/about/`} class="inline-flex rounded-md border border-portfolio-line bg-white px-5 py-3 text-sm font-bold transition hover:border-portfolio-accent hover:text-portfolio-accent dark:border-portfolio-night-line dark:bg-portfolio-night-panel">
          {t.nav.about}
        </a>
      </div>
    </div>
  </section>

  <section class="bg-white/70 py-16 dark:bg-portfolio-night-panel/60">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <SectionHeading title={t.skills.title} intro={t.skills.intro} />
      <div class="mt-8"><TechStack lang={lang} compact /></div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <SectionHeading title={t.proSkills.title} intro={t.proSkills.intro} />
    <div class="mt-8"><ProfessionalSkills lang={lang} short /></div>
  </section>
</BaseLayout>
