---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/home/Hero.astro";
import RoleMarquee from "../../components/home/RoleMarquee.astro";
import SelectedWork from "../../components/home/SelectedWork.astro";
import Pipeline from "../../components/home/Pipeline.astro";
import SkillsConstellation from "../../components/skills/SkillsConstellation.astro";
import ProfessionalSkills from "../../components/ProfessionalSkills.astro";
import { content, cutoutImage, locales, type Locale } from "../../data/content";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = content[lang];
const cutout = cutoutImage();
---

<BaseLayout lang={lang}>
  {
    cutout && (
      <link
        slot="head"
        rel="preload"
        as="image"
        href={cutout.src}
        imagesrcset={cutout.srcset}
        imagesizes={cutout.sizes}
        fetchpriority="high"
      />
    )
  }

  <Hero lang={lang} />
  <RoleMarquee lang={lang} />

  <SelectedWork lang={lang} />
  <Pipeline lang={lang} />

  <section class="wrap defer-render" style="padding-top: clamp(72px, 10vw, 140px);">
    <div class="sec-head reveal"><h2 class="sec-title">{t.skills.title}</h2></div>
    <div style="margin-top: clamp(28px, 4vw, 48px);"><SkillsConstellation lang={lang} compact /></div>
  </section>

  <section class="wrap defer-render" style="padding-block: clamp(72px, 10vw, 140px);">
    <div class="sec-head reveal"><h2 class="sec-title">{t.proSkills.title}</h2></div>
    <div style="margin-top: clamp(28px, 4vw, 48px);"><ProfessionalSkills lang={lang} short /></div>
  </section>
</BaseLayout>
