---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/home/Hero.astro";
import RoleMarquee from "../../components/home/RoleMarquee.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import TechStack from "../../components/TechStack.astro";
import ProfessionalSkills from "../../components/ProfessionalSkills.astro";
import { content, cutoutImage, locales, projects, type Locale } from "../../data/content";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = content[lang];
const featuredProjects = projects.filter((project) => project.tier === "main");
const cutout = cutoutImage();
---

<BaseLayout lang={lang}>
  {
    cutout && (
      <link
        slot="head"
        rel="preload"
        as="image"
        href={cutout.src}
        imagesrcset={cutout.srcset}
        imagesizes={cutout.sizes}
        fetchpriority="high"
      />
    )
  }

  <Hero lang={lang} />
  <RoleMarquee lang={lang} />

  <!-- Temporary sections: rebuilt in the next steps (bento, pipeline, skills). -->
  <section id="work" class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <SectionHeading title={t.projects.title} />
    <div class="mt-10 grid gap-5 md:grid-cols-2">
      {featuredProjects.map((project) => <ProjectCard project={project} lang={lang} />)}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6 lg:px-8">
    <SectionHeading title={t.skills.title} />
    <div class="mt-8"><TechStack lang={lang} compact /></div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6 lg:px-8">
    <SectionHeading title={t.proSkills.title} />
    <div class="mt-8"><ProfessionalSkills lang={lang} short /></div>
  </section>
</BaseLayout>
