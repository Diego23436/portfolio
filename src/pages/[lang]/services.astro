---
import { Icon } from "astro-icon/components";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { content, locales, whatsappLink, type Locale } from "../../data/content";
import "../../styles/pages.css";
import "../../styles/skills.css";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = content[lang];
const s = t.services;
---

<BaseLayout lang={lang} title={t.nav.services} description={s.items.map((item) => item.title).join(", ")}>
  <section class="wrap" style="padding-top: clamp(40px, 7vw, 96px);">
    <h1 class="sec-title">{s.title}</h1>

    <ol class="svc">
      {
        s.items.map((item, index) => (
          <li class="svc-row">
            <div class="svc-in wipe">
              <span class="svc-num mono">{String(index + 1).padStart(2, "0")}</span>
              <div class="svc-main">
                <Icon name={item.icon} class="svc-icon" aria-hidden="true" />
                <h2 class="svc-title">{item.title}</h2>
                <p class="svc-pitch">{item.pitch}</p>
              </div>
              <div class="svc-get">
                <p class="mono">{s.whatYouGet}</p>
                <ul>
                  {item.bullets.map((bullet) => <li>{bullet}</li>)}
                </ul>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="wrap svc-cta">
    <h2 class="svc-cta-title">{s.cta.title}</h2>
    <p class="svc-cta-body">{s.cta.body}</p>
    <div class="svc-cta-actions">
      <a class="btn" href={`/${lang}/contact/`}>{t.actions.contactMe}</a>
      <a class="btn btn--ghost" href={whatsappLink(lang)} target="_blank" rel="noreferrer">{t.actions.whatsapp} ↗</a>
    </div>
  </section>
</BaseLayout>
