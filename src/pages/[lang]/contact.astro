---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { content, locales, profile, whatsappLink, type Locale } from "../../data/content";
import "../../styles/pages.css";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = content[lang];
const c = t.contactPage;
const f = c.form;
---

<BaseLayout lang={lang} title={c.title} description={t.meta.description}>
  <section class="wrap">
    <h1 class="contact-head">
      {c.headBefore}<em>{c.headItalic}</em>{c.headAfter}
    </h1>
    <p class="contact-reply mono">{c.reply}</p>

    <div class="crows">
      <!-- Email: click copies -->
      <button
        type="button"
        class="crow"
        data-copy-text={profile.publicEmail}
        data-copied={c.email.copied}
        data-copy-failed={c.email.failed}
      >
        <span class="crow-label mono">{c.email.label}</span>
        <span class="crow-value">{profile.publicEmail}</span>
        <span class="crow-act mono">{c.email.copy} <span class="crow-arrow" aria-hidden="true">↗</span></span>
      </button>
      <p class="crow-extra mono" style="border-bottom: 1px solid rgb(var(--edge) / 0.2); padding-bottom: 14px;">
        <a href={`mailto:${profile.publicEmail}`}>{c.email.mail}</a>
      </p>

      <!-- WhatsApp -->
      <a class="crow" href={whatsappLink(lang)} target="_blank" rel="noreferrer">
        <span class="crow-label mono">{c.whatsapp.label}</span>
        <span class="crow-value">{profile.phoneDisplay}</span>
        <span class="crow-act mono">{c.whatsapp.open} <span class="crow-arrow" aria-hidden="true">↗</span></span>
      </a>

      <!-- Form -->
      <button type="button" class="crow" data-form-toggle aria-expanded="false" aria-controls="contact-form">
        <span class="crow-label mono">{f.label}</span>
        <span class="crow-value" data-form-open-label>{f.open}</span>
        <span class="crow-act mono"><span data-form-act>+</span></span>
      </button>

      <div class="cform" id="contact-form" data-cform>
        <div class="cform-inner">
          <form
            novalidate
            data-contact-form
            data-endpoint={`https://formsubmit.co/ajax/${profile.formEmail}`}
            data-sending={f.sending}
            data-submit-label={f.submit}
            data-error={f.error}
            data-inv-name={f.invalidName}
            data-inv-email={f.invalidEmail}
            data-inv-subject={f.invalidSubject}
            data-inv-message={f.invalidMessage}
          >
            <input type="text" name="_honey" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <input type="hidden" name="_captcha" value="false" />
            <input type="hidden" name="_template" value="table" />

            <div class="cform-grid">
              <div class="field">
                <input id="f-name" name="name" required autocomplete="name" placeholder=" " aria-describedby="e-name" />
                <label for="f-name">{f.name}</label>
                <p class="field-err" id="e-name" role="alert"></p>
              </div>
              <div class="field">
                <input id="f-email" name="email" type="email" required autocomplete="email" placeholder=" " aria-describedby="e-email" />
                <label for="f-email">{f.email}</label>
                <p class="field-err" id="e-email" role="alert"></p>
              </div>
            </div>
            <div class="field">
              <input id="f-subject" name="subject" required placeholder=" " aria-describedby="e-subject" />
              <label for="f-subject">{f.subject}</label>
              <p class="field-err" id="e-subject" role="alert"></p>
            </div>
            <div class="field">
              <textarea id="f-message" name="message" required rows="6" placeholder=" " aria-describedby="e-message"></textarea>
              <label for="f-message">{f.message}</label>
              <p class="field-err" id="e-message" role="alert"></p>
            </div>

            <div class="form-actions">
              <button type="submit" class="btn" data-submit>{f.submit}</button>
              <p class="sent-line" data-sent hidden role="status"><span class="ok">✓</span> {f.sent}</p>
              <p class="send-error" data-send-error hidden role="alert"></p>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import "../../scripts/contact";
</script>
