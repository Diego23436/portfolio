---
import "@fontsource-variable/inter";
import "@fontsource-variable/bricolage-grotesque/wdth.css";
import "@fontsource/instrument-serif/400-italic.css";
import "@fontsource-variable/jetbrains-mono";
import { content, locales, profile, projects, skillGroups, type Locale } from "../../data/content";
import "../../styles/cv.css";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = content[lang];
const L =
  lang === "en"
    ? {
        pitch: "Web apps, APIs and DevOps: I take products from idea to live deployment.",
        contact: "Contact", skills: "Stack", languages: "Languages", langs: [["English", "First language"], ["French", "Fluent"]],
        education: "Education", experience: "Experience", work: "Selected work", available: "Available for work", live: "Live on the web",
        groups: { frontend: "Front-end", backend: "Back-end", data: "Data", devops: "DevOps" },
      }
    : {
        pitch: "Applications web, APIs et DevOps : je mène les produits de l'idée à la mise en ligne.",
        contact: "Contact", skills: "Stack", languages: "Langues", langs: [["Anglais", "Langue maternelle"], ["Français", "Courant"]],
        education: "Formation", experience: "Expérience", work: "Projets choisis", available: "Disponible", live: "En ligne",
        groups: { frontend: "Front-end", backend: "Back-end", data: "Données", devops: "DevOps" },
      };
const skillName = (skill: { name: string; nameFr?: string }) => (lang === "fr" ? (skill.nameFr ?? skill.name) : skill.name);
// Only the strongest skills (expert or advanced), 5 per group. The full list lives on the site.
const picks = (["frontend", "backend", "data", "devops"] as const).map((id) => {
  const group = skillGroups.find((g) => g.id === id);
  const items = (group?.items ?? []).filter((s) => s.level === "expert" || s.level === "advanced").slice(0, 4);
  return { id, title: L.groups[id], items };
}).filter((g) => g.items.length > 0);
const site = profile.siteUrl.replace("https://", "");
const github = profile.github.replace("https://", "");
const work = projects.filter((p) => p.tier === "main");
const live = projects.filter((p) => p.demoUrl);
const demoHost = (url: string | null) => (url ? url.replace(/^https?:\/\//, "").replace(/\/$/, "") : null);
const photo = "/images/profile/about.webp";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>{profile.name} · CV {lang.toUpperCase()}</title>
  </head>
  <body class="cv-body">
    <main class="cv" id="cv">
      <aside class="cv-side">
        <img class="cv-photo" src={photo} alt="" width="180" height="225" />

        <section>
          <h2>{L.contact}</h2>
          <ul class="cv-contact">
            <li><span>@</span>{profile.publicEmail}</li>
            <li><span>☎</span>{profile.phoneDisplay}</li>
            <li><span>↗</span>{site}</li>
            <li><span>⌥</span>{github}</li>
            <li><span>⌖</span>{profile.location[lang]}</li>
          </ul>
        </section>

        <section>
          <h2>{L.skills}</h2>
          {
            picks.map((g) => (
              <div class="cv-group">
                <h3>{g.title}</h3>
                <p>{g.items.map((s) => skillName(s)).join(" · ")}</p>
              </div>
            ))
          }
        </section>

        <section>
          <h2>{L.education}</h2>
          {
            t.education.items.map((item) => (
              <div class="cv-edu">
                <b>{item.title}</b>
                <span>{item.place}</span>
                {item.period && <em>{item.period}</em>}
              </div>
            ))
          }
        </section>

        <section>
          <h2>{L.languages}</h2>
          <ul class="cv-langs">
            {L.langs.map(([name, level]) => <li><b>{name}</b> <span>{level}</span></li>)}
          </ul>
        </section>
      </aside>

      <div class="cv-main">
        <header class="cv-head">
          <p class="cv-status"><i></i>{L.available} · {profile.location[lang]}</p>
          <h1>{profile.displayName}</h1>
          <p class="cv-full">{profile.name}</p>
          <p class="cv-role">{profile.title}</p>
          <p class="cv-pitch">{L.pitch}</p>
          <ul class="cv-stats">
            {t.hero.counters.map((c) => <li><b>{c.value}</b><span>{c.label}</span></li>)}
          </ul>
        </header>

        <section>
          <h2>{L.experience}</h2>
          {
            t.experience.items.map((item) => (
              <article class="cv-row">
                <div class="cv-row-top">
                  <b>{item.title}</b>
                  <span class="cv-when">{item.period}</span>
                </div>
                <p class="cv-place">{item.place}</p>
                <p>{item.line}</p>
              </article>
            ))
          }
        </section>

        <section>
          <h2>{L.work}</h2>
          {
            work.map((project) => (
              <article class="cv-row">
                <div class="cv-row-top">
                  <b>{project.title}</b>
                  <span class="cv-when">{project.roleShort[lang]}{project.team && !["Solo", "Seul"].includes(project.team.en) ? ` · ${project.team[lang]}` : ""}</span>
                </div>
                <p>{project.hook[lang]}</p>
                {(project.stack.length > 0 || project.demoUrl) && (
                  <p class="cv-meta">
                    {project.stack.slice(0, 5).join(" · ")}
                    {project.stack.length > 0 && project.demoUrl ? " — " : ""}
                    {project.demoUrl && <span class="cv-link">{demoHost(project.demoUrl)}</span>}
                  </p>
                )}
              </article>
            ))
          }
        </section>
        <section>
          <h2>{L.live}</h2>
          <ul class="cv-live">
            {live.map((project) => <li><b>{project.title}</b><span>{demoHost(project.demoUrl)}</span></li>)}
          </ul>
        </section>
      </div>
    </main>
  </body>
</html>
