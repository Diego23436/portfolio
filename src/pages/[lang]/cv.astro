---
import "@fontsource-variable/inter";
import "@fontsource-variable/bricolage-grotesque/wdth.css";
import { content, locales, profile, projects, skillGroups, type Locale } from "../../data/content";
import "../../styles/cv.css";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = content[lang];
const mainProjects = projects.filter((project) => project.tier === "main");
const labels =
  lang === "en"
    ? { profile: "Profile", skills: "Skills", experience: "Experience", projects: "Main projects", education: "Education", languages: "Languages", langLine: "English (first language), French (fluent)", phone: "Phone / WhatsApp" }
    : { profile: "Profil", skills: "Compétences", experience: "Expérience", projects: "Projets principaux", education: "Formation", languages: "Langues", langLine: "Anglais (langue maternelle), français (courant)", phone: "Téléphone / WhatsApp" };
const skillName = (skill: { name: string; nameFr?: string }) => (lang === "fr" ? (skill.nameFr ?? skill.name) : skill.name);
const site = profile.siteUrl.replace("https://", "");
const github = profile.github.replace("https://", "");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>{profile.name} · CV {lang.toUpperCase()}</title>
  </head>
  <body class="cv-body">
    <main class="cv" id="cv">
      <header class="cv-head">
        <h1>{profile.name}</h1>
        <p class="cv-title">{profile.title}</p>
        <p class="cv-contact">
          {profile.publicEmail} · {profile.phoneDisplay} · {site} · {github} · {profile.location[lang]}
        </p>
      </header>

      <section>
        <h2>{labels.profile}</h2>
        <p>{t.about.paragraphs[0]}</p>
      </section>

      <section>
        <h2>{labels.skills}</h2>
        <ul class="cv-skills">
          {
            skillGroups.map((group) => (
              <li>
                <b>{group.title[lang]}:</b> {group.items.map((skill) => skillName(skill)).join(", ")}
              </li>
            ))
          }
        </ul>
      </section>

      <section>
        <h2>{labels.experience}</h2>
        {
          t.experience.items.map((item) => (
            <article class="cv-entry">
              <p class="cv-entry-head">
                <span><b>{item.title}</b> · {item.place}</span>
                {item.period && <span class="cv-when">{item.period}</span>}
              </p>
              <p>{item.line}</p>
            </article>
          ))
        }
      </section>

      <section>
        <h2>{labels.projects}</h2>
        {
          mainProjects.map((project) => (
            <article class="cv-entry">
              <p class="cv-entry-head">
                <span><b>{project.title}</b> · {project.roleShort[lang]}</span>
                {project.team && <span class="cv-when">{project.team[lang]}</span>}
              </p>
              <p>
                {project.hook[lang]}
                {project.stack.length > 0 && <span class="cv-stack"> {project.stack.join(", ")}.</span>}
              </p>
            </article>
          ))
        }
      </section>

      <section>
        <h2>{labels.education}</h2>
        {
          t.education.items.map((item) => (
            <article class="cv-entry">
              <p class="cv-entry-head">
                <span><b>{item.title}</b> · {item.place}</span>
                {item.period && <span class="cv-when">{item.period}</span>}
              </p>
              {item.line && <p>{item.line}</p>}
            </article>
          ))
        }
      </section>

      <section>
        <h2>{labels.languages}</h2>
        <p>{labels.langLine}</p>
      </section>
    </main>
  </body>
</html>
