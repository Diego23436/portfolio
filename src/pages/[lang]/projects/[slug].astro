---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ProjectFrame from "../../../components/projects/ProjectFrame.astro";
import ArchitectureDiagram from "../../../components/projects/ArchitectureDiagram.astro";
import { content, locales, projects, type Locale, type Project } from "../../../data/content";
import "../../../styles/projects.css";

export function getStaticPaths() {
  return locales.flatMap((lang) =>
    projects.map((project, index) => ({
      params: { lang, slug: project.slug },
      props: { lang, project, next: projects[(index + 1) % projects.length] },
    })),
  );
}

const { lang, project, next } = Astro.props as { lang: Locale; project: Project; next: Project };
const t = content[lang];
const d = t.projectDetail;

// Values only, in this order: role · team · year · status. Unknown ones are left out.
const meta = [
  project.roleShort[lang],
  project.team ? project.team[lang] : null,
  project.year,
  project.status ? project.status[lang] : null,
].filter(Boolean) as string[];

const overviewRows = [
  { label: d.role, text: project.role[lang] },
  project.problem && { label: d.problem, text: project.problem[lang] },
  project.solution && { label: d.solution, text: project.solution[lang] },
  project.result && { label: d.result, text: project.result[lang] },
].filter(Boolean) as { label: string; text: string }[];

const sections = [
  { id: "overview", label: d.sections.overview },
  project.architecture && { id: "architecture", label: d.sections.architecture },
  { id: "highlights", label: d.sections.highlights },
  project.learning && { id: "learning", label: d.sections.learning },
].filter(Boolean) as { id: string; label: string }[];
---

<BaseLayout lang={lang} title={project.title} description={project.hook[lang]}>
  <div class="progress" data-progress aria-hidden="true"></div>

  <article class="wrap" data-case>
    <header class="cs-hero">
      <a class="cs-back mono" href={`/${lang}/projects/`}>← {d.back}</a>
      <p class="mono" style="margin-top: 36px; color: rgb(var(--soft));">{project.tag[lang]}</p>
      <h1 class="cs-title" transition:name={`project-title-${project.slug}`}>{project.title}</h1>
      <p class="cs-hook">{project.hook[lang]}</p>

      <p class="cs-meta mono">
        {
          meta.map((item) => (
            <span>
              <b>{item}</b>
            </span>
          ))
        }
      </p>

      <div class="cs-actions">
        {
          project.demoUrl && (
            <a class="btn" href={project.demoUrl} target="_blank" rel="noreferrer">
              {t.actions.viewLive} ↗
            </a>
          )
        }
        {
          !project.confidential && project.repoUrl && (
            <a class="btn btn--ghost" href={project.repoUrl} target="_blank" rel="noreferrer">
              {t.actions.viewRepo} ↗
            </a>
          )
        }
        {project.confidential && <span class="cs-private">{project.privateLabel?.[lang] ?? d.confidential}</span>}
      </div>

      <div class="cs-cover">
        <ProjectFrame project={project} lang={lang} eager />
      </div>

      {
        project.metrics.length > 0 && (
          <dl class="cs-metrics">
            {project.metrics.map((metric) => (
              <div class="cs-metric">
                <dt>{metric.value}</dt>
                <dd>{metric.label[lang]}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </header>

    <div class="cs-body">
      <nav class="cs-nav" data-nav aria-label={d.onThisPage}>
        <p class="mono" style="color: rgb(var(--soft));">{d.onThisPage}</p>
        <ul>
          {sections.map((section) => <li><a href={`#${section.id}`}>{section.label}</a></li>)}
        </ul>
      </nav>

      <div class="cs-main">
        <section class="cs-section" id="overview" data-section>
          <h2 class="cs-h2">{d.sections.overview}</h2>
          <div class="cs-rows">
            {
              overviewRows.map((row) => (
                <div class="cs-row">
                  <span class="mono">{row.label}</span>
                  <p>{row.text}</p>
                </div>
              ))
            }
            {
              project.stack.length > 0 && (
                <div class="cs-row">
                  <span class="mono">{d.stack}</span>
                  <div class="cs-stack">{project.stack.map((item) => <span>{item}</span>)}</div>
                </div>
              )
            }
          </div>
        </section>

        {
          project.architecture && (
            <section class="cs-section cs-section--wide" id="architecture" data-section>
              <h2 class="cs-h2">{d.sections.architecture}</h2>
              <ArchitectureDiagram architecture={project.architecture} lang={lang} label={`${d.diagramLabel}: ${project.title}`} />
            </section>
          )
        }

        <section class="cs-section" id="highlights" data-section>
          <h2 class="cs-h2">{d.sections.highlights}</h2>
          <ol class="cs-list">
            {
              project.highlights[lang].map((item, index) => (
                <li>
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  {item}
                </li>
              ))
            }
          </ol>
        </section>

        {
          project.learning && (
            <section class="cs-section" id="learning" data-section>
              <h2 class="cs-h2">{d.sections.learning}</h2>
              <p class="cs-learning">{project.learning[lang]}</p>
            </section>
          )
        }
      </div>
    </div>

    <a class="next" href={`/${lang}/projects/${next.slug}/`} data-next>
      <span class="mono" style="color: rgb(var(--soft));">{d.nextProject}</span>
      <span class="next-title" transition:name={`project-title-${next.slug}`}>{next.title}</span>
    </a>
    <div class="next-preview" data-next-preview aria-hidden="true">
      <img src={next.image} alt="" width="1200" height="675" loading="lazy" decoding="async" />
    </div>
  </article>
</BaseLayout>

<script>
  import "../../../scripts/case-study";
</script>
