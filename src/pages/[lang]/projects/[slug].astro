---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { content, locales, projects, type Locale } from "../../../data/content";

export function getStaticPaths() {
  return locales.flatMap((lang) =>
    projects.map((project) => ({
      params: { lang, slug: project.slug },
      props: { lang, project },
    })),
  );
}

const { lang, project } = Astro.props as {
  lang: Locale;
  project: (typeof projects)[number];
};
const t = content[lang];
---

<BaseLayout lang={lang} title={project.title[lang]} description={project.summary[lang]}>
  <article class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <a href={`/${lang}/projects/`} class="text-sm font-bold text-portfolio-accent hover:text-portfolio-accent-strong">
      {t.actions.backToProjects}
    </a>

    <div class="mt-8 grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-start">
      <div>
        <p class="text-sm font-black uppercase tracking-[0.16em] text-portfolio-accent">{project.repositoryStatus[lang]}</p>
        <h1 class="mt-4 text-balance text-4xl font-black leading-tight text-portfolio-ink dark:text-white sm:text-5xl">
          {project.title[lang]}
        </h1>
        <p class="mt-5 text-lg leading-8 text-portfolio-muted dark:text-slate-300">{project.summary[lang]}</p>
        <div class="mt-6 flex flex-wrap gap-2">
          {project.stack.map((item) => <span class="rounded-md bg-white px-3 py-1.5 text-xs font-bold text-portfolio-muted ring-1 ring-portfolio-line dark:bg-portfolio-night-panel dark:text-slate-300 dark:ring-portfolio-night-line">{item}</span>)}
        </div>
      </div>

      <div class="rounded-lg border border-portfolio-line bg-white p-4 shadow-xl dark:border-portfolio-night-line dark:bg-portfolio-night-panel">
        <div class="relative overflow-hidden rounded-md bg-portfolio-ink text-white dark:bg-slate-950">
          <img
            src={project.image}
            alt={project.imageAlt[lang]}
            class="aspect-[16/10] w-full object-cover opacity-75"
            loading="eager"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-portfolio-ink via-portfolio-ink/40 to-transparent"></div>
          <div class="absolute inset-x-0 bottom-0 p-6">
            <p class="text-sm font-bold uppercase tracking-[0.16em] text-teal-200">{t.projectDetail.visualLabel}</p>
            <p class="mt-3 text-2xl font-black">{project.title[lang]}</p>
            <p class="mt-3 max-w-md text-sm text-slate-300">{t.projectDetail.visualNote}</p>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-8 flex flex-wrap gap-3">
      {
        "demoUrl" in project && project.demoUrl && (
          <a
            href={project.demoUrl}
            target="_blank"
            rel="noreferrer"
            class="rounded-md bg-portfolio-accent px-5 py-3 text-sm font-bold text-white transition hover:bg-portfolio-accent-strong"
          >
            {t.actions.viewLive}
          </a>
        )
      }
      <a
        href={project.repoUrl}
        target="_blank"
        rel="noreferrer"
        class="rounded-md border border-portfolio-line bg-white px-5 py-3 text-sm font-bold transition hover:border-portfolio-accent hover:text-portfolio-accent dark:border-portfolio-night-line dark:bg-portfolio-night-panel"
      >
        {t.actions.viewRepo}
      </a>
    </div>

    <div class="mt-12 grid gap-5 md:grid-cols-2">
      <section class="rounded-lg border border-portfolio-line bg-white p-6 dark:border-portfolio-night-line dark:bg-portfolio-night-panel">
        <h2 class="text-xl font-black">{t.projectDetail.problem}</h2>
        <p class="mt-3 text-sm leading-7 text-portfolio-muted dark:text-slate-300">{project.problem[lang]}</p>
      </section>
      <section class="rounded-lg border border-portfolio-line bg-white p-6 dark:border-portfolio-night-line dark:bg-portfolio-night-panel">
        <h2 class="text-xl font-black">{t.projectDetail.solution}</h2>
        <p class="mt-3 text-sm leading-7 text-portfolio-muted dark:text-slate-300">{project.solution[lang]}</p>
      </section>
    </div>

    <section class="mt-5 rounded-lg border border-portfolio-line bg-white p-6 dark:border-portfolio-night-line dark:bg-portfolio-night-panel">
      <h2 class="text-xl font-black">{t.projectDetail.highlights}</h2>
      <div class="mt-5 grid gap-3 sm:grid-cols-2">
        {
          project.highlights[lang].map((item) => (
            <div class="rounded-md bg-portfolio-paper p-4 text-sm font-semibold text-portfolio-muted dark:bg-portfolio-night dark:text-slate-300">{item}</div>
          ))
        }
      </div>
    </section>

    <section class="mt-5 rounded-lg border border-portfolio-line bg-white p-6 dark:border-portfolio-night-line dark:bg-portfolio-night-panel">
      <h2 class="text-xl font-black">{t.projectDetail.learning}</h2>
      <p class="mt-3 text-sm leading-7 text-portfolio-muted dark:text-slate-300">{project.learning[lang]}</p>
    </section>
  </article>
</BaseLayout>
