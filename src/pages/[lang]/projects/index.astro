---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SectionHeading from "../../../components/SectionHeading.astro";
import ProjectCard from "../../../components/ProjectCard.astro";
import { content, locales, projects, type Locale } from "../../../data/content";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = content[lang];
---

<BaseLayout lang={lang} title={t.nav.projects}>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <SectionHeading title={t.projects.allTitle} intro={t.projects.allIntro} />
    <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {projects.map((project) => <ProjectCard project={project} lang={lang} />)}
    </div>
  </section>
</BaseLayout>
