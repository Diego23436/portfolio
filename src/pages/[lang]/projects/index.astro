---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ProjectTile from "../../../components/projects/ProjectTile.astro";
import { content, locales, projects, type Category, type Locale } from "../../../data/content";
import "../../../styles/projects.css";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = content[lang];
const filterKeys = ["all", "saas", "client", "team", "devops"] as const;
const count = (key: (typeof filterKeys)[number]) =>
  key === "all" ? projects.length : projects.filter((project) => project.categories.includes(key as Category)).length;
---

<BaseLayout lang={lang} title={t.projects.allTitle} description={t.meta.description}>
  <section class="wrap" data-projects-page style="padding-top: clamp(40px, 7vw, 88px);">
    <div class="sec-head">
      <h1 class="sec-title">{t.projects.allTitle}</h1>
      <p class="sec-link" style="border: 0;">{projects.length} {t.projects.count}</p>
    </div>

    <div class="filters" role="group" aria-label={t.projects.filterLabel} data-filters>
      {
        filterKeys.map((key) => (
          <button type="button" class="chip" data-filter={key} aria-pressed={key === "all" ? "true" : "false"}>
            {t.projects.filters[key]} <small>{count(key)}</small>
          </button>
        ))
      }
    </div>

    <div class="project-grid" data-grid>
      {projects.map((project, index) => <ProjectTile project={project} lang={lang} variant="card" eager={index < 2} />)}
    </div>
    <p class="empty-note" data-empty hidden>{t.projects.emptyFilter}</p>
  </section>

  <div style="height: clamp(72px, 10vw, 140px);"></div>
</BaseLayout>

<script>
  import "../../../scripts/projects-page";
</script>
