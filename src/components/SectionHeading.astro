---
type Props = {
  eyebrow?: string;
  title: string;
  intro?: string;
};

const { eyebrow, title, intro } = Astro.props;
---

<div class="max-w-3xl">
  {eyebrow && <p class="text-sm font-bold uppercase tracking-[0.16em] text-portfolio-accent">{eyebrow}</p>}
  <h2 class="mt-3 text-3xl font-black leading-tight text-portfolio-ink dark:text-white sm:text-4xl">{title}</h2>
  {intro && <p class="mt-4 text-base leading-7 text-portfolio-muted dark:text-slate-300">{intro}</p>}
</div>
