---
import { Icon } from "astro-icon/components";
import { content, projects, skillGroups, type Locale, type SkillLevel } from "../../data/content";
import "../../styles/skills.css";

type Props = { lang: Locale; compact?: boolean };

const { lang, compact = false } = Astro.props;
const s = content[lang].skills;

// The drawing is 1200 wide. Everything below is computed here, at build time: the layout never changes at runtime.
const W = 1200;
const H = compact ? 760 : 840;
const dotCount: Record<SkillLevel, number> = { expert: 3, advanced: 2, working: 1 };
const chipSize: Record<SkillLevel, number> = { expert: 48, advanced: 42, working: 36 };
const rank: Record<SkillLevel, number> = { expert: 0, advanced: 1, working: 2 };

// Cluster centres, in percent of the canvas.
// Mobile has one logo, so it shares a cluster with Frontend.
const clusterOf = (id: string) => (id === "mobile" ? "frontend" : id);
const centres: Record<string, [number, number]> = compact
  ? { frontend: [22, 30], backend: [78, 30], data: [22, 72], devops: [78, 72] }
  : { backend: [50, 25], frontend: [16, 36], data: [84, 36], devops: [50, 71], creative: [16, 73], ai: [84, 73] };

const merged = new Map<string, { id: string; title: { en: string; fr: string }; items: (typeof skillGroups)[number]["items"][number][] }>();
for (const group of skillGroups) {
  const id = clusterOf(group.id);
  if (!centres[id]) continue;
  const items = group.items.filter((item) => !compact || item.level !== "working");
  if (items.length === 0) continue;
  const found = merged.get(id);
  if (found) {
    found.items.push(...items);
    found.title = { en: `${found.title.en} + ${group.title.en}`, fr: `${found.title.fr} + ${group.title.fr}` };
  } else {
    merged.set(id, { id, title: group.title, items: [...items] });
  }
}
const groups = [...merged.values()];

const projectName = (slug: string) => projects.find((project) => project.slug === slug)?.title ?? slug;
const levelLabel = (level: SkillLevel) => s.levels[level].label;

const C = 58; // spiral spacing
let index = 0;
const clusters = groups.map((group, groupIndex) => {
  const [cxPct, cyPct] = centres[group.id];
  const cx = (cxPct / 100) * W;
  const cy = (cyPct / 100) * H;
  const sorted = [...group.items].sort((a, b) => rank[a.level] - rank[b.level]);
  const chips = sorted.map((item, k) => {
    const radius = k === 0 ? 0 : C * Math.sqrt(k);
    const angle = k * 2.39996 + groupIndex * 0.9; // golden angle: an even, repeatable spiral
    const name = lang === "fr" ? (item.nameFr ?? item.name) : item.name;
    return {
      item,
      name,
      x: cx + radius * Math.cos(angle),
      y: cy + radius * Math.sin(angle) * 0.92,
      size: chipSize[item.level],
      float: 5 + ((k + groupIndex) % 4), // seconds, 5 to 8
      delay: -((k * 1.3 + groupIndex * 0.7) % 6),
      order: index++,
      used: item.usedIn.map((slug) => ({ t: projectName(slug), h: `/${lang}/projects/${slug}/`, slug })),
    };
  });
  const reach = C * Math.sqrt(Math.max(chips.length - 1, 0)) + 30;
  return { group, cx, cy, chips, labelY: cy - reach - 6 };
});

const i18n = JSON.stringify({
  levels: Object.fromEntries(((["expert", "advanced", "working"] as const)).map((level) => [level, s.levels[level].label])),
  dots: dotCount,
  usedIn: s.usedIn,
  close: s.close,
});

const links = clusters.flatMap((cluster) =>
  cluster.chips.slice(1).map((chip, k) => {
    const earlier = cluster.chips.slice(0, k + 1);
    const nearest = earlier.reduce((best, other) => (Math.hypot(other.x - chip.x, other.y - chip.y) < Math.hypot(best.x - chip.x, best.y - chip.y) ? other : best));
    return { x1: nearest.x, y1: nearest.y, x2: chip.x, y2: chip.y };
  }),
);

// Short names for the pills at the bottom edge, so they never collide.
const pillName = (title: string) => (title.length > 14 && title.includes(" ") ? title.split(" ").slice(0, title.startsWith("PDV") ? 2 : 1).join(" ") : title);

const pills = projects.map((project, i) => ({ slug: project.slug, title: pillName(project.title), x: ((i + 0.5) / projects.length) * W, y: H - 20 }));
const pct = (value: number, total: number) => `${((value / total) * 100).toFixed(3)}%`;
---

<div class="skills" data-skills data-lang={lang} data-i18n={i18n}>
  <div class="skills-top">
    <ul class="skills-legend" aria-label={s.legendTitle}>
      {
        (["expert", "advanced", "working"] as const).map((level) => (
          <li>
            <span class="dots" aria-hidden="true">
              {[1, 2, 3].map((n) => <i class:list={{ on: n <= dotCount[level] }}></i>)}
            </span>
            <span>{s.levels[level].label}</span>
          </li>
        ))
      }
    </ul>

    <div class="skills-filters" role="group" aria-label={s.filterLabel}>
      <button type="button" class="chip" data-skill-filter="all" aria-pressed="true">{s.filterAll}</button>
      {groups.map((group) => <button type="button" class="chip" data-skill-filter={group.id} aria-pressed="false">{group.title[lang]}</button>)}
    </div>
  </div>

  <!-- Desktop: constellation -->
  <div class="skills-canvas" data-canvas style={`--ratio: ${W} / ${H};`} role="group" aria-label={s.canvasLabel}>
    <svg class="skills-lines" viewBox={`0 0 ${W} ${H}`} aria-hidden="true">
      <g class="skills-links">{links.map((link) => <line x1={link.x1.toFixed(1)} y1={link.y1.toFixed(1)} x2={link.x2.toFixed(1)} y2={link.y2.toFixed(1)} />)}</g>
      <g data-lines></g>
    </svg>
    {
      clusters.map((cluster) => (
        <span class="cluster-label" data-group={cluster.group.id} style={`left:${pct(cluster.cx, W)};top:${pct(cluster.labelY, H)}`}>
          {cluster.group.title[lang]}
        </span>
      ))
    }
    {
      clusters.map((cluster) =>
        cluster.chips.map((chip) => (
          <button
            type="button"
            class="skill-chip"
            data-skill
            data-group={cluster.group.id}
            data-name={chip.name}
            data-level={chip.item.level}
            data-used={JSON.stringify(chip.used)}
            aria-label={`${chip.name}, ${levelLabel(chip.item.level)}`}
            style={`left:${pct(chip.x, W)};top:${pct(chip.y, H)};--s:${chip.size}px;--d:${chip.float}s;--delay:${chip.delay.toFixed(1)}s;--i:${chip.order}`}
          >
            <span class="skill-chip-in"><Icon name={chip.item.icon} aria-hidden="true" /></span>
          </button>
        )),
      )
    }
    {pills.map((pill) => <span class="skill-pill" data-pill={pill.slug} style={`left:${pct(pill.x, W)};top:${pct(pill.y, H)}`}>{pill.title}</span>)}
    <div class="skill-tip" data-tip hidden></div>
  </div>

  <!-- Tablet and phone: grouped grid -->
  <div class="skills-grid">
    {
      clusters.map((cluster) => (
        <section class="skills-group">
          <h3>{cluster.group.title[lang]}</h3>
          <ul>
            {cluster.chips.map((chip) => (
              <li>
                <button
                  type="button"
                  class="skill-row"
                  data-skill-btn
                  data-name={chip.name}
                  data-level={chip.item.level}
                  data-used={JSON.stringify(chip.used)}
                >
                  <Icon name={chip.item.icon} aria-hidden="true" />
                  <span>{chip.name}</span>
                  <span class="dots" aria-hidden="true">
                    {[1, 2, 3].map((n) => <i class:list={{ on: n <= dotCount[chip.item.level] }}></i>)}
                  </span>
                  <span class="sr-only">{levelLabel(chip.item.level)}</span>
                </button>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <!-- Screen readers get the whole map as a list -->
  <div class="sr-only">
    {
      clusters.map((cluster) => (
        <section>
          <h3>{cluster.group.title[lang]}</h3>
          <ul>
            {cluster.chips.map((chip) => (
              <li>
                {chip.name}: {levelLabel(chip.item.level)}.{" "}
                {chip.used.length > 0 ? `${s.usedIn}: ${chip.used.map((u) => u.t).join(", ")}.` : ""}
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <div class="sheet" data-sheet hidden role="dialog" aria-modal="true" aria-label={s.title}>
    <div class="sheet-card" data-sheet-card></div>
  </div>
</div>

<script>
  import "../../scripts/skills";
</script>
