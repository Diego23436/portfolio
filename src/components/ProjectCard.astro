---
import { content, type Locale, type Project } from "../data/content";

type Props = {
  project: Project;
  lang: Locale;
  compact?: boolean;
  eager?: boolean;
};

const { project, lang, compact = false, eager = false } = Astro.props;
const t = content[lang];
const href = `/${lang}/projects/${project.slug}/`;
---

<article class="reveal group grid h-full overflow-hidden rounded-xl border border-portfolio-line bg-white shadow-sm transition hover:-translate-y-1 hover:border-portfolio-accent hover:shadow-xl dark:border-portfolio-night-line dark:bg-portfolio-night-panel">
  <div class:list={["relative overflow-hidden bg-portfolio-ink", compact ? "aspect-[21/9]" : "aspect-[16/9]"]}>
    <img
      src={project.image}
      alt={project.imageAlt[lang]}
      width="1200"
      height="675"
      loading={eager ? "eager" : "lazy"}
      decoding="async"
      class="size-full object-cover transition duration-500 group-hover:scale-105"
    />
  </div>
  <div class="grid gap-4 p-5">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.14em] text-portfolio-accent">{project.kind[lang]}</p>
      <h3 class="mt-2 text-xl font-black">{project.title}</h3>
    </div>
    <p class="text-sm leading-6 text-portfolio-muted dark:text-slate-300">{project.summary[lang]}</p>
    {
      !compact && project.stack.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {project.stack.map((item) => (
            <span class="rounded-md bg-portfolio-paper px-2.5 py-1 text-xs font-bold text-portfolio-muted dark:bg-portfolio-night dark:text-slate-300">{item}</span>
          ))}
        </div>
      )
    }
    {
      project.confidential && (
        <p class="text-xs font-semibold text-portfolio-muted dark:text-slate-400">{t.projectDetail.confidential}</p>
      )
    }
    <div class="mt-auto flex flex-wrap gap-2">
      <a
        href={href}
        class="inline-flex rounded-md bg-portfolio-ink px-4 py-2 text-sm font-bold text-white transition group-hover:bg-portfolio-accent-solid dark:bg-slate-100 dark:text-portfolio-night dark:group-hover:bg-portfolio-accent-solid dark:group-hover:text-white"
      >
        {t.actions.viewCaseStudy}
      </a>
      {
        project.demoUrl && (
          <a
            href={project.demoUrl}
            target="_blank"
            rel="noreferrer"
            class="inline-flex rounded-md border border-portfolio-line px-4 py-2 text-sm font-bold transition hover:border-portfolio-accent hover:text-portfolio-accent dark:border-portfolio-night-line"
          >
            {t.actions.viewLive}
          </a>
        )
      }
    </div>
  </div>
</article>
