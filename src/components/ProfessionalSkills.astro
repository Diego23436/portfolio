---
import { content, type Locale } from "../data/content";
import "../styles/skills.css";

type Props = {
  lang: Locale;
  /** Short version (home): only the items marked `short`. */
  short?: boolean;
};

const { lang, short = false } = Astro.props;
const items = content[lang].proSkills.items.filter((item) => !short || item.short);
---

<ol class="pro">
  {
    items.map((item, index) => (
      <li class="pro-row">
        <div class="pro-in wipe">
          <span class="pro-num">{String(index + 1).padStart(2, "0")}</span>
          <h3 class="pro-title">{item.title}</h3>
          <p class="pro-proof">{item.proof}</p>
        </div>
      </li>
    ))
  }
</ol>
