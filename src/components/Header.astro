---
import { Icon } from "astro-icon/components";
import CvDownload from "./CvDownload.astro";
import "../styles/palette.css";
import { content, localeLabels, profile, type Locale } from "../data/content";

type Props = {
  lang: Locale;
};

const { lang } = Astro.props;
const t = content[lang];
const otherLang: Locale = lang === "en" ? "fr" : "en";
const currentPath = Astro.url.pathname;
const otherPath = currentPath.startsWith(`/${lang}`)
  ? currentPath.replace(`/${lang}`, `/${otherLang}`)
  : `/${otherLang}/`;

const navItems = [
  { label: t.nav.home, href: `/${lang}/` },
  { label: t.nav.about, href: `/${lang}/about/` },
  { label: t.nav.projects, href: `/${lang}/projects/` },
  { label: t.nav.services, href: `/${lang}/services/` },
  { label: t.nav.contact, href: `/${lang}/contact/` },
].map((item) => {
  const normalized = currentPath.endsWith("/") ? currentPath : `${currentPath}/`;
  const isHome = item.href === `/${lang}/`;
  return { ...item, active: isHome ? normalized === item.href : normalized.startsWith(item.href) };
});

const linkBase = "rounded-md px-3 py-2 text-sm font-medium transition";
const linkIdle =
  "text-portfolio-muted hover:bg-portfolio-panel hover:text-portfolio-ink dark:text-slate-300 dark:hover:bg-portfolio-night-panel dark:hover:text-white";
const linkActive = "bg-portfolio-accent/10 font-semibold text-portfolio-accent";
---

<header class="sticky top-0 z-40 border-b border-portfolio-line/80 bg-portfolio-paper/85 backdrop-blur-xl dark:border-portfolio-night-line dark:bg-portfolio-night/85">
  <a
    href="#main"
    class="sr-only-focusable absolute left-4 top-2 z-50 rounded-md bg-portfolio-accent-solid px-3 py-2 text-sm font-bold text-white focus:static"
  >
    {t.actions.skipToContent}
  </a>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
    <a href={`/${lang}/`} class="group flex items-center gap-3" aria-label={t.nav.home}>
      <span class="grid size-10 place-items-center rounded-lg bg-portfolio-ink font-display text-sm font-bold text-white transition-colors group-hover:bg-portfolio-accent-solid dark:bg-slate-100 dark:text-portfolio-night dark:group-hover:text-white">
        {profile.initials}
      </span>
      <span class="leading-tight">
        <span class="block text-sm font-bold">{profile.displayName}</span>
        <span class="hidden text-xs text-portfolio-muted sm:block dark:text-slate-400">{profile.title}</span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label={t.actions.mainNav}>
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={item.active ? "page" : undefined}
            class:list={[linkBase, item.active ? linkActive : linkIdle]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-2 md:flex">
      <button type="button" class="kbd" data-palette-open aria-label={t.palette.open}><span data-palette-key>Ctrl K</span></button>
      <CvDownload lang={lang} compact />
      <a
        href={otherPath}
        class="rounded-md border border-portfolio-line bg-portfolio-panel px-3 py-2 text-sm font-bold text-portfolio-ink transition hover:border-portfolio-accent hover:text-portfolio-accent dark:border-portfolio-night-line dark:bg-portfolio-night-panel dark:text-slate-100"
        aria-label={localeLabels[otherLang].label}
        hreflang={otherLang}
      >
        {localeLabels[otherLang].short}
      </a>
      <button
        type="button"
        data-theme-toggle
        class="theme-toggle relative grid size-10 place-items-center rounded-full border border-edge/20 bg-surface text-fg transition hover:border-accent"
        aria-label={t.actions.theme}
        aria-pressed="false"
      >
        <Icon name="lucide:sun" class="ti ti-sun size-5" aria-hidden="true" />
        <Icon name="lucide:moon" class="ti ti-moon size-5" aria-hidden="true" />
      </button>
    </div>

    <details class="relative md:hidden" data-mobile-menu>
      <summary
        class="cursor-pointer rounded-md border border-portfolio-line bg-portfolio-panel px-4 py-2 text-sm font-bold dark:border-portfolio-night-line dark:bg-portfolio-night-panel"
      >
        {t.actions.menu}
      </summary>
      <div class="absolute right-0 mt-3 w-[min(18rem,calc(100vw-2rem))] rounded-xl border border-portfolio-line bg-portfolio-panel p-3 shadow-2xl dark:border-portfolio-night-line dark:bg-portfolio-night-panel">
        <nav class="grid gap-1" aria-label={t.actions.mobileNav}>
          {
            navItems.map((item) => (
              <a
                href={item.href}
                aria-current={item.active ? "page" : undefined}
                class:list={["block", linkBase, item.active ? linkActive : linkIdle]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <button type="button" class="kbd mt-3 w-full justify-center" data-palette-open aria-label={t.palette.open}><span data-palette-key>Ctrl K</span> · {t.palette.open}</button>
        <div class="mt-3 grid grid-cols-[1fr_auto_auto] items-center gap-2 border-t border-portfolio-line pt-3 dark:border-portfolio-night-line">
          <CvDownload lang={lang} compact />
          <a
            href={otherPath}
            class="rounded-md border border-portfolio-line px-3 py-2 text-sm font-bold dark:border-portfolio-night-line"
            aria-label={localeLabels[otherLang].label}
            hreflang={otherLang}
          >
            {localeLabels[otherLang].short}
          </a>
          <button
            type="button"
            data-theme-toggle
            class="theme-toggle relative grid size-10 place-items-center rounded-full border border-edge/20 text-fg"
            aria-label={t.actions.theme}
            aria-pressed="false"
          >
            <Icon name="lucide:sun" class="ti ti-sun size-5" aria-hidden="true" />
            <Icon name="lucide:moon" class="ti ti-moon size-5" aria-hidden="true" />
          </button>
        </div>
      </div>
    </details>
  </div>
</header>

<script>
  // Close the mobile menu after a tap on a link, a tap outside, or the Escape key.
  // The listeners sit on the document and look the menu up each time,
  // so they keep working after page changes (View Transitions).
  const openMenu = () => document.querySelector<HTMLDetailsElement>("[data-mobile-menu][open]");
  document.addEventListener("click", (event) => {
    const menu = openMenu();
    if (!menu) return;
    const target = event.target as HTMLElement;
    if (target.closest("[data-mobile-menu] nav a") || !menu.contains(target)) menu.open = false;
  });
  document.addEventListener("keydown", (event) => {
    const menu = openMenu();
    if (event.key === "Escape" && menu) {
      menu.open = false;
      menu.querySelector("summary")?.focus();
    }
  });
</script>
