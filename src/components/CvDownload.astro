---
import { content, profile, type Locale } from "../data/content";

type Props = {
  lang: Locale;
  compact?: boolean;
};

const { lang, compact = false } = Astro.props;
const t = content[lang];
---

<details class="relative">
  <summary
    class:list={[
      "cursor-pointer rounded-md border border-portfolio-accent bg-portfolio-accent px-4 py-2 text-sm font-bold text-white transition hover:bg-portfolio-accent-strong",
      compact && "px-3",
    ]}
  >
    {compact ? "CV" : t.actions.downloadCv}
  </summary>
  <div class="absolute right-0 z-50 mt-2 min-w-52 rounded-lg border border-portfolio-line bg-white p-2 shadow-2xl dark:border-portfolio-night-line dark:bg-portfolio-night-panel">
    <a
      href={profile.resume.en}
      download
      class="block rounded-md px-3 py-2 text-sm font-semibold text-portfolio-ink hover:bg-portfolio-paper dark:text-slate-100 dark:hover:bg-portfolio-night"
    >
      {t.actions.englishCv}
    </a>
    {
      profile.resume.fr ? (
        <a
          href={profile.resume.fr}
          download
          class="block rounded-md px-3 py-2 text-sm font-semibold text-portfolio-ink hover:bg-portfolio-paper dark:text-slate-100 dark:hover:bg-portfolio-night"
        >
          {t.actions.frenchCv}
        </a>
      ) : (
        <span class="block rounded-md px-3 py-2 text-sm font-semibold text-portfolio-muted dark:text-slate-400">
          {t.actions.frenchCv} · {t.actions.unavailable}
        </span>
      )
    }
  </div>
</details>
