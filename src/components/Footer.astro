---
import { Icon } from "astro-icon/components";
import { content, profile, whatsappLink, type Locale } from "../data/content";
import { build } from "../data/build";
import "../styles/pages.css";

type Props = { lang: Locale };

const { lang } = Astro.props;
const t = content[lang];
const year = new Date().getFullYear();
---

<footer class="foot" data-footer>
  <div class="foot-inner">
    <div class="wm" data-wordmark aria-hidden="true">
      <span class="wm-line">NK FORLAN</span>
      <span class="wm-fill">NK FORLAN</span>
    </div>

    <div class="foot-row">
      <p class="foot-time mono">
        <i aria-hidden="true"></i>
        <span data-clock data-suffix={t.hero.clock}>--:-- {t.hero.clock}</span>
      </p>
      <ul class="foot-links">
        <li>
          <a href={profile.github} target="_blank" rel="noreferrer">
            <Icon name="simple-icons:github" aria-hidden="true" />{t.actions.github}
          </a>
        </li>
        {
          profile.linkedin && (
            <li>
              <a href={profile.linkedin} target="_blank" rel="noreferrer">
                <Icon name="simple-icons:linkedin" aria-hidden="true" />{t.actions.linkedin}
              </a>
            </li>
          )
        }
        <li>
          <a href={`mailto:${profile.publicEmail}`}>
            <Icon name="lucide:mail" aria-hidden="true" />{profile.publicEmail}
          </a>
        </li>
        <li>
          <a href={whatsappLink(lang)} target="_blank" rel="noreferrer">
            <Icon name="simple-icons:whatsapp" aria-hidden="true" />{t.actions.whatsapp}
          </a>
        </li>
        <li>
          <a href={profile.resume[lang]} download>
            <Icon name="lucide:file-down" aria-hidden="true" />{t.footer.cv}
          </a>
        </li>
      </ul>
    </div>

    <div class="foot-meta mono">
      <span>© {year} {profile.displayName}</span>
      <span>{build.version} · build {build.hash} · {t.footer.build}</span>
    </div>
  </div>
</footer>

<script>
  import "../scripts/footer";
</script>
