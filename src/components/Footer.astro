---
import { content, profile, type Locale } from "../data/content";

type Props = {
  lang: Locale;
};

const { lang } = Astro.props;
const t = content[lang];
---

<footer class="border-t border-portfolio-line bg-white/70 dark:border-portfolio-night-line dark:bg-portfolio-night-panel/60">
  <div class="mx-auto grid max-w-6xl gap-6 px-4 py-8 sm:px-6 md:grid-cols-[1fr_auto] lg:px-8">
    <div>
      <p class="text-sm font-bold">{profile.name}</p>
      <p class="mt-2 max-w-xl text-sm text-portfolio-muted dark:text-slate-400">{t.footer}</p>
    </div>
    <div class="flex flex-wrap items-center gap-3 text-sm font-semibold">
      <a class="text-portfolio-muted transition hover:text-portfolio-accent dark:text-slate-400" href={profile.github}>GitHub</a>
      <a class="text-portfolio-muted transition hover:text-portfolio-accent dark:text-slate-400" href={profile.linkedin}>LinkedIn</a>
      <a class="text-portfolio-muted transition hover:text-portfolio-accent dark:text-slate-400" href={`mailto:${profile.email}`}>{profile.email}</a>
    </div>
  </div>
</footer>
