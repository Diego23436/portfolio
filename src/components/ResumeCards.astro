---
import { content, profile, type Locale } from "../data/content";

type Props = {
  lang: Locale;
};

const { lang } = Astro.props;
const t = content[lang];
---

<div class="grid gap-5 md:grid-cols-2">
  <article class="reveal rounded-xl border border-portfolio-line bg-white p-6 dark:border-portfolio-night-line dark:bg-portfolio-night-panel">
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-portfolio-accent">EN</p>
    <h3 class="mt-3 text-2xl font-black">{t.actions.englishCv}</h3>
    <p class="mt-3 text-sm leading-6 text-portfolio-muted dark:text-slate-300">{t.resumePage.ready}</p>
    <a href={profile.resume.en} download class="mt-6 inline-flex rounded-md bg-portfolio-ink px-5 py-3 text-sm font-bold text-white transition hover:bg-portfolio-accent-solid dark:bg-slate-100 dark:text-portfolio-night dark:hover:bg-portfolio-accent-solid dark:hover:text-white">
      {t.actions.downloadCv}
    </a>
  </article>

  <article class="reveal rounded-xl border border-portfolio-line bg-white p-6 dark:border-portfolio-night-line dark:bg-portfolio-night-panel">
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-portfolio-accent">FR</p>
    <h3 class="mt-3 text-2xl font-black">{t.actions.frenchCv}</h3>
    <p class="mt-3 text-sm leading-6 text-portfolio-muted dark:text-slate-300">{t.resumePage.ready}</p>
    <a href={profile.resume.fr} download class="mt-6 inline-flex rounded-md bg-portfolio-ink px-5 py-3 text-sm font-bold text-white transition hover:bg-portfolio-accent-solid dark:bg-slate-100 dark:text-portfolio-night dark:hover:bg-portfolio-accent-solid dark:hover:text-white">
      {t.actions.downloadCv}
    </a>
  </article>
</div>
