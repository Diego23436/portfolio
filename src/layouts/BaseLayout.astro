---
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { content, profile, type Locale } from "../data/content";
import "../styles/global.css";

type Props = {
  lang: Locale;
  title?: string;
  description?: string;
};

const { lang, title, description } = Astro.props;
const t = content[lang];
const pageTitle = title ? `${title} | ${profile.displayName}` : t.meta.title;
const pageDescription = description ?? t.meta.description;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#070B14" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#F6F8FC" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <slot name="head" />
    <ClientRouter />
    <script is:inline>
      // Runs before the page paints (no flash). Dark first: dark unless the visitor chose light.
      (() => {
        const apply = () => {
          const root = document.documentElement;
          root.classList.add("js");
          let saved = null;
          try {
            saved = localStorage.getItem("theme");
          } catch (error) {}
          root.classList.toggle("dark", saved ? saved === "dark" : true);
        };
        apply();
        if (!window.__themeSwap) {
          window.__themeSwap = true;
          // First page load of the visit: allow the hero entrance animation (a page change removes this class).
          if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("intro");
          // View Transitions replace the document: apply the theme again after each swap.
          document.addEventListener("astro:after-swap", apply);
        }
      })();
    </script>
  </head>
  <body class="bg-canvas font-sans text-fg antialiased">
    <div class="spotlight" data-spotlight aria-hidden="true"></div>
    <div class="grain" aria-hidden="true"></div>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <div class="toast" data-toast role="status" aria-live="polite"></div>
    <script>
      import "../scripts/foundation";
    </script>
  </body>
</html>
